# ===============================================
# DeepSeek AI Configuration (Recommended)
# ===============================================
# Get your DeepSeek API key from https://platform.deepseek.com/api_keys (starts with sk-...)
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ===============================================
# Groq AI Configuration (Optional Fallback)
# ===============================================
# Get your Groq API key from https://console.groq.com/keys (starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ===============================================
# Meta WhatsApp Cloud API Configuration
# ===============================================
# From Meta Developers > WhatsApp > API Setup:
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=whatsapp_groq_bot_secret_123
